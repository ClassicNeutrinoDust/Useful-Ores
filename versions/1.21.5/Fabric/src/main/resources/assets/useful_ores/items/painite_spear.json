{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": [
          "gui"
        ],
        "model": {
          "type": "minecraft:condition",
          "property": "minecraft:has_component",
          "component": "useful_ores:painite_fury_tool",
          "on_true": {
            "type": "minecraft:model",
            "model": "useful_ores:item/painite_spear_fury"
          },
          "on_false": {
            "type": "minecraft:model",
            "model": "useful_ores:item/painite_spear"
          }
        }
      },
      {
        "when": [
          "firstperson_lefthand",
          "firstperson_righthand",
          "thirdperson_lefthand",
          "thirdperson_righthand"
        ],
        "model": {
          "type": "minecraft:condition",
          "property": "minecraft:has_component",
          "component": "useful_ores:painite_fury_tool",
          "on_true": {
            "type": "minecraft:model",
            "model": "useful_ores:item/painite_spear_in_hand_fury"
          },
          "on_false": {
            "type": "minecraft:model",
            "model": "useful_ores:item/painite_spear_in_hand"
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:condition",
      "property": "minecraft:has_component",
      "component": "useful_ores:painite_fury_tool",
      "on_true": {
        "type": "minecraft:model",
        "model": "useful_ores:item/painite_spear"
      },
      "on_false": {
        "type": "minecraft:model",
        "model": "useful_ores:item/painite_spear"
      }
    }
  }
}
