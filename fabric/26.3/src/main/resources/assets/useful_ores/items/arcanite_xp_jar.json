        { "threshold": 4, "model": { "type": "minecraft:model", "model": "useful_ores:item/arcanite_xp_jar_icon_4" } },
        { "threshold": 5, "model": { "type": "minecraft:model", "model": "useful_ores:item/arcanite_xp_jar_icon_5" } },
        { "threshold": 6, "model": { "type": "minecraft:model", "model": "useful_ores:item/arcanite_xp_jar_icon_6" } },
        { "threshold": 7, "model": { "type": "minecraft:model", "model": "useful_ores:item/arcanite_xp_jar_icon_7" } }
