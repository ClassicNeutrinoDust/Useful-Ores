    "useful_ores.fabric.mixins.json",
    "useful_ores.sound.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.1",
    "fabric-api": "*",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "geckolib": ">=5.4.0 <5.5.0"
  },
  "suggests": {
