{
  "schemaVersion": 1,
  "id": "useful_ores",
  "version": "${version}",
  "name": "Useful Ores",
  "description": "Adds 14 ores and recipes (Swords, Armors, Tools and Blocks)",
  "authors": [
    "NeutrinoDust"
  ],
  "license": "MIT",
  "icon": "useful_ores.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.neutrinodust.useful_ores.UsefulOresMod"
    ],
    "client": [
      "com.neutrinodust.useful_ores.client.UsefulOresModClient"
    ]
  },
  "mixins": [
